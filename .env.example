# Angel One SmartAPI Credentials Template
# Copy this file to .env and fill in your confidential API details.
# DO NOT commit .env with real credentials to version control.

# Angel One SmartAPI Details
ANGEL_API_KEY="your_smartapi_api_key_here"
ANGEL_CLIENT_CODE="your_client_code_here"
ANGEL_PIN="your_mpin_here"
ANGEL_TOTP_SECRET="your_totp_secret_key_here"

# System Operation Mode ("paper" | "live")
SYSTEM_ENVIRONMENT="paper"

# Database Configuration
DATABASE_PATH="trade_journal.db"
